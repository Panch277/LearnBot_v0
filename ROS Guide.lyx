\begin_layout Subsection*
Prerequisites 
\end_layout

\begin_layout Enumerate

\series bold
Set locale
\series default
, we have to make sure we have a locale wich supports UTF-8.
\begin_inset listings
lstparams "language=bash"
inline false
status open

\begin_layout Plain Layout

locale  # check for UTF-8
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

sudo apt update && sudo apt install locales
\end_layout

\begin_layout Plain Layout

sudo locale-gen en_US en_US.UTF-8
\end_layout

\begin_layout Plain Layout

sudo update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
\end_layout

\begin_layout Plain Layout

export LANG=en_US.UTF-8
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

locale  # verify settings
\end_layout

\end_inset


\end_layout

\begin_layout Enumerate

\series bold
Setup Sources
\series default
, let's add the ROS apt repository to our system.
\begin_inset listings
lstparams "language=bash"
inline false
status open

\begin_layout Plain Layout

sudo apt install software-properties-common 
\end_layout

\begin_layout Plain Layout

sudo add-apt-repository universe
\end_layout

\end_inset

Now add the ROS2 GPG key with apt.
 GPG keys are to verify the authenticity of packages.
 "Packages from the ROS repository are trusted and safe to install."
\begin_inset listings
lstparams "language=bash"
inline false
status open

\begin_layout Plain Layout

sudo apt update && sudo apt install
\end_layout

\begin_layout Plain Layout

curl -y sudo curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.k
ey -o /usr/share/keyrings/ros-archive-keyring.gpg
\end_layout

\end_inset

Then add the repository to your sources list.
\begin_inset listings
lstparams "language=bash"
inline false
status open

\begin_layout Plain Layout

echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-a
rchive-keyring.gpg] http://packages.ros.org/ros2/ubuntu $(.
 /etc/os-release && echo $UBUNTU_CODENAME) main" | sudo tee /etc/apt/sources.list.
d/ros2.list > /dev/null
\end_layout

\end_inset


\end_layout

